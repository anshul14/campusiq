        <mxCell id="dCognito" value="Cognito User Pool&#xa;• Entra ID / Google / SAML federation&#xa;• Pre-Token Generation Lambda&#xa;  (injects studentId, grade, role)&#xa;• Post-Auth Lambda&#xa;  (profile sync on federated login)&#xa;• Custom JWT claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontSize=10;" vertex="1" parent="1">
