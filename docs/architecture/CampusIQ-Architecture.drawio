  <diagram name="5 - Content Ingestion Flow" id="p5">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CampusIQ — Content Ingestion Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1B3A5C;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="700" height="36" as="geometry" />
        </mxCell>
        <!-- Rich Text path -->
        <mxCell id="rtHeader" value="PATH A — Rich Text (Markdown)" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="rtEditor" value="Teacher writes in&#xa;BlockNote Editor&#xa;(Next.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rtAutosave" value="Autosave Lambda&#xa;PUT /content/text&#xa;(debounced 2s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rtS3" value="S3&#xa;content.md saved&#xa;{domain}/{courseId}/&#xa;modules/{moduleId}/content.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="140" height="80" as="geometry" />
        </mxCell>
        <!-- PDF path -->
        <mxCell id="pdfHeader" value="PATH B — PDF Upload" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pdfDrop" value="Teacher drags PDF&#xa;onto upload zone&#xa;(react-dropzone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pdfPresign" value="Presign Lambda&#xa;POST /content/pdf/presign&#xa;Returns S3 PUT URL&#xa;(15 min expiry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pdfS3Direct" value="Browser uploads&#xa;directly to S3&#xa;(bypasses API GW&#xa;— no Lambda cost)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="330" width="140" height="80" as="geometry" />
        </mxCell>
        <!-- Video path -->
        <mxCell id="vidHeader" value="PATH C — Video Upload" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="70" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="vidUpload" value="Teacher uploads MP4&#xa;via pre-signed URL&#xa;Direct to S3&#xa;/raw-uploads/ prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="vidS3Event" value="S3 ObjectCreated&#xa;event fires" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="660" y="240" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vidMC" value="MediaConvert&#xa;MP4 → HLS segments&#xa;Saved to S3 /media/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="340" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vidTranscribe" value="Amazon Transcribe&#xa;Audio → WebVTT&#xa;Saved to S3&#xa;transcript.vtt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="340" width="140" height="70" as="geometry" />
        </mxCell>
        <!-- Common converge -->
