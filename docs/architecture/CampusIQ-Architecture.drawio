          <mxGeometry x="380" y="470" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="kbSync" value="Bedrock KB&#xa;Data Source Sync&#xa;Text chunked at&#xa;512 tokens / 20% overlap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="230" y="580" width="160" height="80" as="geometry" />
