  <diagram name="2 - Authentication Flow" id="p2">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CampusIQ — Authentication Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1B3A5C;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="700" height="36" as="geometry" />
        </mxCell>
        <!-- Actors -->
        <mxCell id="student" value="👤 Student&#xa;Browser" style="shape=mxgraph.flowchart.start_2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nextjsApp" value="Next.js&#xa;App&#xa;(NextAuth.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="110" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cognitoBox" value="Amazon Cognito&#xa;User Pool&#xa;(Per Institution)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="110" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="idpBox" value="Institution IdP&#xa;(Entra ID / Google&#xa;/ SAML)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="110" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="preTokenLambda" value="Pre-Token&#xa;Generation Lambda&#xa;(Enrich JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="260" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apigwBox" value="API Gateway&#xa;+ Lambda Authorizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="420" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="backendLambda" value="Backend Lambda&#xa;(request.state&#xa;.authorizer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="420" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dynamoBox" value="DynamoDB&#xa;PK=STUDENT#{sub}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="420" width="140" height="60" as="geometry" />
        </mxCell>
        <!-- Step labels -->
        <mxCell id="s1" value="1. Navigate to CampusIQ login" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="130" y="120" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Detect institution&#xa;from email domain" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="90" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s3label" value="3. Redirect to&#xa;Cognito Hosted UI&#xa;→ IdP OIDC/SAML" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4label" value="4. IdP authenticates&#xa;user, returns&#xa;authorization_code" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="580" y="175" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5label" value="5. Pre-Token Lambda&#xa;enriches JWT with&#xa;studentId, role, grade" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="240" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s6label" value="6. Cognito issues JWT&#xa;NextAuth stores in&#xa;HTTP-only cookie" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="130" y="240" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s7label" value="7. API calls with&#xa;Bearer token" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="130" y="380" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s8label" value="8. Authorizer validates&#xa;JWT, injects role&#xa;+ sub into context" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s9label" value="9. Lambda reads&#xa;role + sub,&#xa;queries DynamoDB" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=center;fontSize=9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="580" y="390" width="80" height="60" as="geometry" />
        </mxCell>
        <!-- JWT claim box -->
