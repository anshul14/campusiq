  <diagram name="3 - Cognitive Learning Loop" id="p3">
    <mxGraphModel dx="1426" dy="780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CampusIQ — Cognitive Learning Loop" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1B3A5C;" parent="1" vertex="1">
          <mxGeometry x="200" y="15" width="700" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Closed-feedback event-driven cycle — every quiz result continuously reshapes the student&#39;s learning experience" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="100" y="48" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cStep1" value="① Student Submits Quiz&#xa;POST /quiz/submit&#xa;(Quiz Lambda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="80" y="100" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cStep2" value="② Quiz Result Written&#xa;to DynamoDB&#xa;PK=STUDENT#{sub}&#xa;SK=RESULT#{course}#{module}#{attempt}&#xa;concept_scores: {friction: 0.2}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="320" y="85" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cStep3" value="③ DynamoDB Stream&#xa;NEW_AND_OLD_IMAGES&#xa;fires on write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="570" y="100" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cStep4" value="④ Stream Processor Lambda&#xa;Translates DynamoDB event&#xa;→ EventBridge QuizCompleted event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="790" y="90" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cStep5" value="⑤ EventBridge&#xa;Custom Event Bus&#xa;source: campusiq.student&#xa;detail-type: QuizCompleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="570" y="240" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cStep6" value="⑥ Gap Detection Lambda&#xa;Calculates concept weakness&#xa;gap_severity: 0.0–1.0&#xa;Writes GAP records to DynamoDB&#xa;GSI2_SK = zero-padded severity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="320" y="230" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cStep7" value="⑦ If severity ≥ 0.700&#xa;→ GapDetected event fired&#xa;→ Faculty Alert Lambda&#xa;→ TeacherAlert record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="80" y="230" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cStep8" value="⑧ Recommendation Lambda&#xa;Queries Amazon Personalize&#xa;with gap context&#xa;Updates LearningPath in DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="790" y="250" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cStep9" value="⑨ Content Adaptation Lambda&#xa;Adjusts next module difficulty&#xa;via Bedrock InvokeModel&#xa;Rewrites content at new level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="790" y="410" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cStep10" value="⑩ Next Tutor Call:&#xa;Orchestrator reads top 5 gaps&#xa;via GapSeverityIndex GSI&#xa;Injects gap context into&#xa;every Tutor Agent prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="320" y="420" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cStep11" value="⑪ Student Next Session:&#xa;Sees personalised module sequence&#xa;Tutor proactively addresses weak concepts&#xa;Content at adjusted difficulty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="80" y="420" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="loopLabel" value="🔁 LOOP REPEATS ON EVERY INTERACTION" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="570" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="severityBox" value="gap_severity scale:&#xa;0.0 = Mastered&#xa;0.3 = Developing&#xa;0.7 = At-Risk threshold&#xa;1.0 = Unknown / Not seen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="60" y="570" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ebSchema" value="EventBridge event shape:&#xa;{ source: &#39;campusiq.student&#39;,&#xa;  detail-type: &#39;QuizCompleted&#39;,&#xa;  detail: { studentId, courseId,&#xa;  moduleId, score, weakConcepts,&#xa;  domain, timestamp } }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="570" y="400" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep1" target="cStep2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep2" target="cStep3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep3" target="cStep4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep4" target="cStep5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep5" target="cStep6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep6" target="cStep7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep5" target="cStep8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce8" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep8" target="cStep9" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce9" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep6" target="cStep10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce10" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep10" target="cStep11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce11" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="cStep11" target="cStep1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
