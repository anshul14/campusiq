          <mxGeometry x="280" y="200" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tTutorLambda" value="Tutor Lambda&#xa;(FastAPI + Mangum)&#xa;1024MB / 30s timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="110" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tRedis" value="ElastiCache Redis&#xa;Read conversation&#xa;history (session_id)&#xa;24hr TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="490" y="230" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tOrchestrator" value="🎯 Orchestrator Agent&#xa;Bedrock AgentCore Runtime&#xa;Claude 3.5 Sonnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="110" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tDynamo1" value="DynamoDB&#xa;Read student profile&#xa;+ enrolments&#xa;+ progress summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="230" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tDynamo2" value="DynamoDB&#xa;GapSeverityIndex GSI&#xa;Top 5 weakest concepts&#xa;ScanIndexForward=False" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="920" y="230" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tTutorAgent" value="🎓 Tutor Agent&#xa;Bedrock AgentCore Runtime&#xa;RAG over Knowledge Base&#xa;Claude 3.5 Sonnet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="390" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tKB" value="📚 Bedrock Knowledge Base&#xa;OpenSearch Serverless&#xa;Vector search over&#xa;course content chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="390" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tGuardrails" value="Bedrock Guardrails&#xa;Domain-specific&#xa;content filtering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="520" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tResponse" value="Response returned&#xa;to student&#xa;(non-streaming)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="530" width="150" height="60" as="geometry" />
        </mxCell>
        <!-- Enriched context box -->
        <mxCell id="enrichBox" value="Enriched Context Payload (Orchestrator injects before dispatch):&#xa;• Student profile: name, grade, domain, enrolled courses&#xa;• Gap summary: top 5 weakest concepts with severity scores&#xa;• Active learning path: recommended next modules&#xa;• Domain config: guardrails profile, tutor persona, temperature&#xa;• Conversation history: last N turns from Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="610" height="110" as="geometry" />
        </mxCell>
        <!-- EventStream note -->
