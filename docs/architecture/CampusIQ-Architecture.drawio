        <mxCell id="dAppPy" value="infrastructure/cdk/app.py&#xa;Reads config&#xa;Instantiates stacks&#xa;cdk deploy --all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
