      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CampusIQ — Tutor Chat Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1B3A5C;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="700" height="36" as="geometry" />
        </mxCell>
        <!-- Components -->
        <mxCell id="tStudent" value="👤 Student&#xa;(Next.js TutorSidebar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tApigw" value="API Gateway&#xa;POST /tutor/chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="110" width="140" height="50" as="geometry" />
